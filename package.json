{
  "name": "pi-career",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained private Pi tools and Agent Skill for deterministic Career Core workflows",
  "license": "MIT OR Apache-2.0",
  "author": {
    "name": "Revaz Zakalashvili",
    "url": "https://github.com/revazi"
  },
  "homepage": "https://github.com/revazi/pi-career#readme",
  "bugs": {
    "url": "https://github.com/revazi/pi-career/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revazi/pi-career.git"
  },
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "docs",
    "runtime",
    "skills",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "NOTICE"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs/promises').then(({rm}) => rm('dist', {recursive:true, force:true}))\"",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:process && npm run test:runtime",
    "test:process": "node --import tsx --test tests/process/process.test.mjs",
    "test:runtime": "node --import tsx --test tests/runtime/runtime.test.mjs",
    "test:bundled-runtime": "node scripts/test-bundled-runtime.mjs",
    "test:pi-smoke": "node scripts/test-pi-package-load.mjs",
    "test:install": "node scripts/test-isolated-install.mjs",
    "test:compat": "node scripts/test-bundled-runtime-compat.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:runtime-artifacts": "node scripts/check-runtime-artifacts.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:runtime": "node scripts/check-runtime-boundary.mjs",
    "audit:runtime": "npm audit --omit=dev",
    "check:syntax": "node --check scripts/*.mjs tests/process/*.mjs tests/runtime/*.mjs",
    "check": "npm run typecheck && npm run check:dist && npm run check:runtime-artifacts && npm test && npm run check:runtime && npm run check:links && npm run check:secrets && npm run check:syntax"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "24.12.4",
    "esbuild": "0.28.1",
    "tsx": "4.23.5",
    "typebox": "1.1.38",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills/career-core"
    ]
  }
}
